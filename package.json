{
  "name": "@binom/account-menu",
  "version": "0.2.0",
  "description": "The Binom header menus for every Binom app: the account menu on the right (profile, credits, Manage team, Settings, Sign out, the app's own rows, version) and the team switcher beside the app's name.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": "github:binom-com/account-menu",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./account-menu.js": {
      "types": "./src/index.d.ts",
      "default": "./src/account-menu.js"
    },
    "./team-switcher.js": {
      "types": "./src/index.d.ts",
      "default": "./src/team-switcher.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs"
  ],
  "sideEffects": [
    "./src/index.js",
    "./src/account-menu.js",
    "./src/team-switcher.js",
    "./src/react.js"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "python3 -m http.server 5190"
  },
  "peerDependencies": {
    "@binom/ui": ">=0.1.1",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@binom/ui": "https://github.com/binom-com/ui/archive/refs/tags/v0.1.1.tar.gz",
    "@happy-dom/global-registrator": "^21.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=18"
  }
}
